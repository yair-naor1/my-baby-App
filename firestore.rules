rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isBookMember(bookId) {
      return signedIn()
        && request.auth.uid in
          get(/databases/$(database)/documents/books/$(bookId))
            .data.ownerIds;
    }

    match /users/{userId} {
      allow read, create, update, delete:
        if signedIn() && request.auth.uid == userId;
    }

    match /books/{bookId} {
      allow create:
        if signedIn()
        && request.auth.uid in request.resource.data.ownerIds;

      allow read, update, delete:
        if signedIn()
        && request.auth.uid in resource.data.ownerIds;

      match /memories/{memoryId} {
        allow read, create, update, delete:
          if isBookMember(bookId);
      }
    }
  }
}